{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.wdesign.wiseiptv.tv",
  "productName": "Wise IPTV TV",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "m3u",
        "name": "M3U IPTV Playlist",
        "role": "Viewer"
      },
      {
        "ext": "m3u8",
        "name": "M3U8 HLS IPTV Playlist",
        "role": "Viewer"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Wise IPTV TV"
  }
}
